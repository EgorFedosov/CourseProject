@startuml
left to right direction
hide empty description
skinparam backgroundColor white
skinparam shadowing false

skinparam state {
  BackgroundColor white
  BorderColor black
  FontColor black
}

state "Документ\nне загружен" as S1
state "Документ\nзагружен" as S2
state "Выполняется\nанализ" as S3
state "Тип документа\nопределён" as S4
state "Семестр документа\nопределён" as S5
state "Требования\nпроверены" as S6
state "Отчёт\nсформирован" as S7
state "Ошибка\nанализа" as S8

[*] --> S1
S1 -> S2 : загрузитьДокумент() / сохранитьФайл()
S2 -> S3 : запуститьАнализ()

S3 -> S4 : определитьТипДокумента()
S4 -> S5 : определитьСеместр()
S5 -> S6 : проверитьТребования()
S6 -> S7 : сформироватьОтчёт()

S2 --> S8 : [неподдерживаемый формат]
S3 --> S8 : [сбой анализа]
S4 --> S8 : [тип не определён]
S5 --> S8 : [семестр не определён]
S6 --> S8 : [ошибка проверки]

S8 --> S2 : повторитьАнализ()
S7 --> [*]

@enduml