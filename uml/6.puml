@startuml
skinparam backgroundColor white
skinparam shadowing false

actor "Студент" as Student
participant "Пользовательский\nинтерфейс" as UI
participant "Модуль загрузки\nдокументов" as Upload
participant "Модуль анализа\nдокументов" as Analysis
participant "Модуль определения\nтипа документа" as TypeModule
participant "Модуль определения\nсеместра" as SemesterModule
participant "Модуль проверки\nтребований" as ValidationModule
database "База знаний" as KB
database "Хранилище\nрезультатов" as ResultDB
participant "Модуль формирования\nотчёта" as ReportModule

Student -> UI : загрузитьДокумент(файл)
UI -> Upload : передатьДокумент(файл)
Upload -> Upload : сохранитьДокумент()
Upload --> UI : документЗагружен

Student -> UI : запуститьАнализ()
UI -> Analysis : начатьАнализ(документ)

Analysis -> TypeModule : определитьТип(документ)
TypeModule -> KB : получитьПравилаТипов()
KB --> TypeModule : правилаТипов
TypeModule --> Analysis : типДокумента

Analysis -> SemesterModule : определитьСеместр(документ)
SemesterModule -> KB : получитьПравилаСеместров()
KB --> SemesterModule : правилаСеместров
SemesterModule --> Analysis : семестрДокумента

Analysis -> ValidationModule : проверитьТребования(документ, тип, семестр)
ValidationModule -> KB : получитьПравилаПроверки()
KB --> ValidationModule : правилаПроверки
ValidationModule --> Analysis : результатыПроверки

Analysis -> ResultDB : сохранитьРезультаты()
ResultDB --> Analysis : результатыСохранены

Analysis -> ReportModule : сформироватьОтчёт(результаты)
ReportModule -> ResultDB : получитьРезультаты()
ResultDB --> ReportModule : данныеПроверки
ReportModule --> UI : отчётСформирован

UI --> Student : отобразитьОтчёт()

@enduml