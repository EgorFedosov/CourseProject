@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam componentStyle rectangle

actor "Студент" as Student
actor "Преподаватель" as Teacher

component "Пользовательский интерфейс" as UI
component "Компонент загрузки\nдокумента" as Upload
component "Компонент анализа\nдокумента" as Analysis
component "Компонент определения\nтипа документа" as TypeDetect
component "Компонент определения\nсеместра" as SemesterDetect
component "Компонент проверки\nтребований" as RequirementCheck
component "Компонент формирования\nотчёта" as ReportGen
database "База знаний" as KnowledgeBase
database "Хранилище\nдокументов" as DocStorage
database "Хранилище\nрезультатов" as ResultStorage

Student --> UI
Teacher --> UI

UI --> Upload
UI --> Analysis
UI --> ReportGen

Upload --> DocStorage
Upload --> Analysis

Analysis --> TypeDetect
Analysis --> SemesterDetect
Analysis --> RequirementCheck

TypeDetect --> KnowledgeBase
SemesterDetect --> KnowledgeBase
RequirementCheck --> KnowledgeBase

Analysis --> ResultStorage
RequirementCheck --> ResultStorage
ReportGen --> ResultStorage
ReportGen --> UI

@enduml