APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
NEO4J_INIT_ON_STARTUP=true
NEO4J_ASSETS_PATH=../neo4j

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1
AI_RETRY_MAX_BACKOFF_SECONDS=8
AI_SIMILAR_CASES_LIMIT=5
